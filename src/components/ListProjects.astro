---
import ProjectCard from "@components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projetos = await getCollection("projects");

const projetosOrdenados = projetos.sort(
    (a: any, b: any) => b.data.pubDate - a.data.pubDate,
);
---

<section class="projects-line">
    <div class="count-projects">
        <span>Exibindo {projetosOrdenados.length} de {projetosOrdenados.length} projetos</span>
        <div class="order-project">
            <span>Ordenar: Mais recentes</span>
            <!-- <img src="../assets/arrow_up.svg" alt="" /> -->
        </div>
    </div>

    <div class="view-projects">
        <ul id="projects-list" class="list-projects">
            {
                projetos.map((projeto) => (
                    <ProjectCard
                        id={projeto.id}
                        key={projeto.data.id}
                        title={projeto.data.title}
                        description={projeto.data.description}
                        tags={projeto.data.tags}
                        year={projeto.data.pubDate.getFullYear()}
                    />
                ))
            }
        </ul>
        <p class="no-results" hidden>
            Nenhum projeto encontrado. Tente outro termo ou filtro.
        </p>
    </div>
</section>
